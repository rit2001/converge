{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node", "vitest/globals"],
    "incremental": true
  },
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "app", "src"],
  "exclude": ["node_modules"]
}
