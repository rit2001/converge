    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@converge/database": "workspace:*",
    "@converge/observability": "workspace:*",
    "@converge/protocol": "workspace:*",
    "redis": "6.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "tsx": "4.20.4",
    "vitest": "3.2.4"
  }
}
