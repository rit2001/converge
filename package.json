{
  "name": "converge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.18.0 <23",
    "pnpm": ">=10.15.0 <11"
  },
  "scripts": {
    "benchmark:k6:check": "pnpm --filter @converge/k6 test && node --test scripts/k6-smoke-harness.test.mjs && pnpm --filter @converge/k6 lint",
    "benchmark:k6:acceptance": "node scripts/run-isolated-k6-smoke.mjs",
    "benchmark:k6:baseline": "CONVERGE_K6_ACCEPTANCE_MODE=baseline node scripts/run-isolated-k6-smoke.mjs",
    "benchmark:k6:scale-step": "CONVERGE_K6_ACCEPTANCE_MODE=scale-step node scripts/run-isolated-k6-smoke.mjs",
    "benchmark:k6:scale-gate": "CONVERGE_K6_ACCEPTANCE_MODE=scale-gate node scripts/run-isolated-k6-smoke.mjs",
    "benchmark:k6:bounded-one": "CONVERGE_K6_ACCEPTANCE_MODE=bounded-one node scripts/run-isolated-k6-smoke.mjs",
    "benchmark:k6:bounded-two": "CONVERGE_K6_ACCEPTANCE_MODE=bounded-two node scripts/run-isolated-k6-smoke.mjs",
    "benchmark:k6:bounded-ten": "CONVERGE_K6_ACCEPTANCE_MODE=bounded-ten node scripts/run-isolated-k6-smoke.mjs",
    "benchmark:k6:bounded-30s": "CONVERGE_K6_ACCEPTANCE_MODE=bounded-30s node scripts/run-isolated-k6-smoke.mjs",
    "benchmark:k6:debug": "CONVERGE_K6_ACCEPTANCE_MODE=debug node scripts/run-isolated-k6-smoke.mjs",
    "benchmark:k6:concurrent": "CONVERGE_K6_ACCEPTANCE_MODE=concurrent node scripts/run-isolated-k6-smoke.mjs",
    "benchmark:k6:repeat": "CONVERGE_K6_ACCEPTANCE_MODE=repeat node scripts/run-isolated-k6-smoke.mjs",
    "benchmark:k6:preflight": "CONVERGE_K6_ACCEPTANCE_MODE=preflight node scripts/run-isolated-k6-smoke.mjs",
    "benchmark:k6:sequential": "CONVERGE_K6_ACCEPTANCE_MODE=sequential node scripts/run-isolated-k6-smoke.mjs",
    "benchmark:k6:smoke": "node scripts/run-k6-smoke.mjs",
    "build": "turbo build",
    "check:web-budgets": "node scripts/check-web-budgets.mjs",
    "check:prometheus": "node scripts/check-prometheus.mjs",
    "dev": "node scripts/root-environment.mjs pnpm run dev:workspace",
    "dev:workspace": "turbo dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint scripts && turbo lint",
    "migrate": "node scripts/root-environment.mjs pnpm --filter @converge/database migrate",
    "test": "node --test scripts/root-environment.test.mjs && turbo test --filter=!@converge/integration --filter=!@converge/playwright --filter=!@converge/k6 --filter=!@converge/failure",
    "test:integration": "node scripts/root-environment.mjs pnpm --filter @converge/integration test",
    "test:playwright": "node scripts/root-environment.mjs pnpm --filter @converge/playwright test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.22",
    "@eslint/js": "9.33.0",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0"
  }
}
