{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "HOST",
    "API_PORT",
    "WEB_ORIGIN",
    "NEXT_PUBLIC_API_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "LOG_LEVEL",
    "DEV_AUTH_USER_ID",
    "DEV_AUTH_USER_NAME",
    "WORKER_ID",
    "OUTBOX_CLAIM_BATCH_SIZE",
    "OUTBOX_PUBLISH_CONCURRENCY",
    "OUTBOX_LEASE_MS",
    "OUTBOX_FINALIZATION_MARGIN_MS",
    "OUTBOX_IDLE_POLL_MS",
    "OUTBOX_POLL_JITTER_RATIO",
    "REDIS_PUBLISH_TIMEOUT_MS",
    "DELIVERY_ENVELOPE_MAX_BYTES",
    "REDIS_STREAM_KEY",
    "REDIS_STREAM_MAXLEN",
    "REDIS_STREAM_MAX_AGE_MS",
    "WORKER_SHUTDOWN_GRACE_MS",
    "CI"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "typecheck": { "dependsOn": ["^typecheck"] }
  }
}
